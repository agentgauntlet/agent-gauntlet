# PostgreSQL (Neon or any Postgres provider)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# GitHub OAuth (create at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth (create at linkedin.com/developers)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Public URL of your deployment (used for OAuth redirects)
APP_URL=http://localhost:3080

# Private scoring service (leave unset to use local fallback scorer)
# Hosted deployment sets this to the internal scoring service URL.
SCORING_URL=
SCORING_AUTH_TOKEN=
