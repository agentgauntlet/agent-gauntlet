node_modules/
.data/
.certs/
*.pem

# Environment & secrets
.env
.env.*
!.env.example

# Built/obfuscated files — generated by `npm run build`, not committed
public/*.min.js

# Product docs (strategy, roadmap, pricing — keep off both repos until reviewed).
# `doc/*` (not `doc/`) so git descends into the directory and the negation
# below can re-include the hackathon subdir explicitly. With `doc/` git
# refuses to descend at all and the negation has no effect.
doc/*
# Exception: hackathon docs are intentionally public (participants read them)
!doc/hackathon/

# OS
.DS_Store
Thumbs.db
