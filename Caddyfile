:8080 {
    # Cart checkout (v1 + v2) — API, page, and static asset routes
    handle /v2 {
        reverse_proxy localhost:3000
    }
    handle /v2.js {
        reverse_proxy localhost:3000
    }
    handle /v2.min.js {
        reverse_proxy localhost:3000
    }
    handle /app.js {
        reverse_proxy localhost:3000
    }
    handle /styles.css {
        reverse_proxy localhost:3000
    }
    handle /api/v2/* {
        reverse_proxy localhost:3000
    }
    # /api/session covers both the v1 POST and the new
    # GET /api/session/:id/result endpoint added in Phase 1. The glob is
    # important — without the * suffix the result lookup fell through to
    # the landing service's catch-all and returned an HTML 404.
    handle /api/session* {
        reverse_proxy localhost:3000
    }
    handle /api/checkout {
        reverse_proxy localhost:3000
    }
    handle /warmup {
        rewrite * /
        reverse_proxy localhost:3000
    }

    # Payment checkout — UI at /payment/, API at /api/payment/*
    handle /payment* {
        uri strip_prefix /payment
        reverse_proxy localhost:3001
    }
    handle /api/payment/* {
        reverse_proxy localhost:3001
    }

    # Bank login — UI at /login/, API at /api/login/*
    handle /login* {
        uri strip_prefix /login
        reverse_proxy localhost:3002
    }
    handle /api/login/* {
        reverse_proxy localhost:3002
    }

    # Product search — UI at /search/, API at /api/search/*
    handle /search* {
        uri strip_prefix /search
        reverse_proxy localhost:3003
    }
    handle /api/search/* {
        reverse_proxy localhost:3003
    }

    # Auction — UI at /auction/, API at /api/auction/*
    handle /auction* {
        uri strip_prefix /auction
        reverse_proxy localhost:3004
    }
    handle /api/auction/* {
        reverse_proxy localhost:3004
    }

    # Crypto exchange — UI at /crypto/, API at /api/crypto/*
    handle /crypto* {
        uri strip_prefix /crypto
        reverse_proxy localhost:3005
    }
    handle /api/crypto/* {
        reverse_proxy localhost:3005
    }

    # Image CAPTCHA — UI at /captcha/, API at /api/captcha/*
    handle /captcha* {
        uri strip_prefix /captcha
        reverse_proxy localhost:3006
    }
    handle /api/captcha/* {
        reverse_proxy localhost:3006
    }

    # API key registration + info (any scenario server works, routed to cart)
    handle /api/keys/* {
        reverse_proxy localhost:3000
    }

    # detect.js shared browser modules (every scenario serves /shared/* —
    # route to cart for consistency with /api/leaderboard)
    handle /shared/* {
        reverse_proxy localhost:3000
    }

    # /api/detect/{token,score} endpoints — registered by createScenario()
    # on every scenario server. Route to cart.
    handle /api/detect/* {
        reverse_proxy localhost:3000
    }

    # /api/enterprise/* — pub/secret key management endpoints, also
    # registered by createScenario().
    handle /api/enterprise/* {
        reverse_proxy localhost:3000
    }

    # Health check — every scenario registers /api/health, route to cart
    # for consistency. Used by the /event/:slug/check page and any external
    # uptime monitor.
    handle /api/health {
        reverse_proxy localhost:3000
    }

    # Leaderboard (served by cart, shared DB)
    handle /leaderboard* {
        reverse_proxy localhost:3000
    }
    handle /api/leaderboard {
        reverse_proxy localhost:3000
    }
    handle /api/risk-weights {
        reverse_proxy localhost:3000
    }

    # Hackathon events (mounted by createScenario() on the cart-checkout
    # service when ENABLE_EVENTS=true). /api/events/* is the cohort +
    # leaderboard API; /event/<slug>* serves the leaderboard HTML page.
    handle /api/events/* {
        reverse_proxy localhost:3000
    }
    handle /event/* {
        reverse_proxy localhost:3000
    }

    # Landing page (everything else)
    handle {
        reverse_proxy localhost:3080
    }
}
